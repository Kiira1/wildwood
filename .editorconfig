root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Two trailing spaces are a line break in Markdown.
[*.md]
trim_trailing_whitespace = false

# The Windows launchers keep Windows line endings (see .gitattributes).
[*.{bat,ps1}]
end_of_line = crlf

# Native app sources follow their platforms' four-space style.
[*.{java,kt,gradle,swift,py}]
indent_size = 4

# Xcode project files are tab-indented and written by Xcode.
[*.{pbxproj,plist}]
indent_style = tab

# Generated by spacetime:generate; never edited by hand.
[src/module_bindings/**]
insert_final_newline = unset
trim_trailing_whitespace = unset
